# Application
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=faculty_evaluation
DB_USERNAME=root
DB_PASSWORD=""

# Session
SESSION_LIFETIME=120
SESSION_REMEMBER_LIFETIME=10080
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict

# Security
BCRYPT_COST=12
RATE_LIMIT_ATTEMPTS=5
RATE_LIMIT_WINDOW=900
ACCOUNT_LOCKOUT_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION=900

# MFA
MFA_ISSUER="DORSU Faculty Evaluation"
MFA_WINDOW=1

# Email Domain Restriction
ALLOWED_EMAIL_DOMAIN=dorsu.edu.ph

# Departments (comma-separated)
DEPARTMENTS="College of Engineering,College of Computer Studies,College of Business Administration,College of Education,College of Arts and Sciences,College of Nursing,College of Agriculture,Graduate School"
